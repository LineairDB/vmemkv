---
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  misc-include-cleaner

WarningsAsErrors: >
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  misc-include-cleaner

HeaderFilterRegex: '(^|.*/)(src|include/vmemkv)/.*\.(hpp|cpp)$'
FormatStyle: none
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: 'bits/.*'
